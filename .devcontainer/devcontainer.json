{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "postCreateCommand": "bash ./.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "solana.solana"
      ]
    }
  },
  "mounts": [
    "source=anchor-global-cache,target=/home/codespace/.anchor",
    "source=rust-cache,target=/home/codespace/.cargo"
  ]
}
